# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real credentials.

# Gmail account used to send lead digests
GMAIL_ADDRESS=

# Gmail App Password (16 characters, generated at
# https://myaccount.google.com/apppasswords — NOT your normal password)
GMAIL_APP_PASSWORD=

# --- Private dashboard auth gate (see web/SETUP.md) -------------------------
# Used by invite_colleague.py and deploy_dashboard.py. SUPABASE_SERVICE_ROLE_KEY
# is a full-admin secret — never share it, never put it in web/ (browser code),
# only ever in this .env file and in Vercel's server-side Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides — defaults shown are fine unless you changed the bucket
# name / storage path during Supabase setup.
# SUPABASE_DASHBOARD_BUCKET=dashboard-private
# SUPABASE_DASHBOARD_PATH=dashboard.html

# Your deployed site's URL (e.g. https://bastak-leads.vercel.app), used so
# invite emails link to the right place. Leave blank to fall back to
# Supabase's default Site URL setting.
# DASHBOARD_SITE_URL=
